# ========== Telegram ==========
# Token del bot creato con @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Il tuo user ID Telegram (verificalo con @userinfobot): solo tu potrai controllare il bot
TELEGRAM_ADMIN_ID=767500041

# ========== Aster DEX (Pro API V3) ==========
# Crea l'API wallet su https://www.asterdex.com/en/api-wallet (tab "Pro API")
# ATTENZIONE: non condividere MAI la chiave privata e non committarla su git!
ASTER_USER_ADDRESS=0x...      # indirizzo del wallet principale (quello con cui fai login)
ASTER_SIGNER_ADDRESS=0x9382a4b0b2Ee61d319BA92AAa1ba98a5AFc05466    # indirizzo dell'API wallet (signer/agent)
ASTER_PRIVATE_KEY=0x...       # chiave privata dell'API wallet (SOLO nel .env locale!)
# ASTER_BASE_URL=https://fapi3.asterdex.com

# ========== Trading ==========
# Mercati seguiti in parallelo (separati da virgola): piu' mercati = piu' segnali.
# SYMBOLS=AUTO seleziona da sola i perpetual piu' scambiati nelle ultime 24h
# (quanti: AUTO_SYMBOLS_COUNT, oppure scrivi direttamente AUTO:30)
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,ASTERUSDT
AUTO_SYMBOLS_COUNT=20
INTERVAL=3m            # timeframe candele: 1m 3m 5m 15m 30m 1h 4h ... (piu' basso = piu' trade)
LEVERAGE=3
MARGIN_TYPE=CROSSED    # CROSSED oppure ISOLATED
LOOP_SECONDS=30        # ogni quanti secondi il bot controlla i mercati
MAX_OPEN_POSITIONS=3   # posizioni aperte contemporaneamente al massimo

# ========== Rischio ==========
RISK_PER_TRADE_PCT=1.0     # % del saldo rischiata per trade
MAX_POSITION_USDT=100      # nozionale massimo della posizione
STOP_LOSS_ATR=1.5          # stop loss = 1.5 x ATR
TAKE_PROFIT_ATR=3.0        # take profit = 3 x ATR
MAX_DAILY_LOSS_PCT=5.0     # oltre questa perdita giornaliera il bot si ferma

# ========== Strategia ==========
# ema_cross     = incrocio EMA + filtro RSI (pochi trade, segue il trend)
# rsi_reversion = RSI ipervenduto/ipercomprato (molti trade, scalping)
# breakout      = rottura del canale di Donchian (segue gli strappi)
# Tutte aprono sia LONG che SHORT.
STRATEGY=ema_cross
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
RSI_LONG_MAX=70
RSI_SHORT_MIN=30
RSI_BUY_BELOW=30       # (rsi_reversion) LONG sotto questa soglia
RSI_SELL_ABOVE=70      # (rsi_reversion) SHORT sopra questa soglia
DONCHIAN_PERIOD=20     # (breakout) ampiezza del canale in candele
ATR_PERIOD=14

# ========== Commissioni simulate ==========
FEE_TAKER_PCT=0.035    # taker fee di Aster per lato (apertura E chiusura)
SLIPPAGE_PCT=0.01      # scivolamento stimato degli ordini a mercato, per lato

# ========== PRESET SCALPING (~20+ trade/ora, SOLO per test in simulazione!) ==========
# Per provarlo, decommenta queste righe (togli il #) al posto dei valori sopra:
# STRATEGY=rsi_reversion
# INTERVAL=1m
# SYMBOLS=AUTO
# AUTO_SYMBOLS_COUNT=20
# MAX_OPEN_POSITIONS=8
# LOOP_SECONDS=15
# RSI_PERIOD=7
# RSI_BUY_BELOW=30
# RSI_SELL_ABOVE=70
# STOP_LOSS_ATR=1.2
# TAKE_PROFIT_ATR=1.8
# ATTENZIONE: a questa frequenza le commissioni (0.07% a giro) pesano tantissimo:
# guarda /pnl per vedere quanto si mangiano prima anche solo di pensare a DRY_RUN=false.

# ========== Sicurezza ==========
# true = simulazione (nessun ordine reale). Metti false SOLO quando sei pronto.
DRY_RUN=true

# ========== Hosting (opzionale) ==========
# PORT=8080   # abilita il server di health-check
